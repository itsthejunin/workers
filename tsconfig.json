{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@boilerplate/*": ["./src/*"],
      "@workbench/*": ["./packages/workbench/src/*"],
      "@utils/*": ["./src/utils/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@config/*": ["./src/config/*"],
      "@health/*": ["./src/health/*"],
      "@queue/*": ["./src/queue/*"],
      "@services/*": ["./src/services/*"]
    }
  }
}